# Copy to .env.local (gitignored) and fill in. vue-cli only exposes variables
# prefixed with VUE_APP_ to the bundle, and inlines them at build time.
#
# These are the local-development path and the fallback. A build also writes
# dist/config.json from the same values, and the app prefers that file at
# runtime - see README > Runtime configuration.
#
# The Auth0 values come from the API's Terraform outputs:
#   terraform -chdir=terraform output auth0_domain
#   terraform -chdir=terraform output auth0_spa_client_id
#   terraform -chdir=terraform output auth0_audience
#   terraform -chdir=terraform output api_endpoint

# Auth0 tenant domain, e.g. relay-synth.eu.auth0.com
VUE_APP_AUTH0_DOMAIN=

# Client ID of the Auth0 application of type "Single Page Application".
VUE_APP_AUTH0_CLIENT_ID=

# Must equal auth0_api_identifier in the API's tfvars, or API Gateway's JWT
# authorizer rejects the token. Defaults to VUE_APP_API_BASE_URL when unset,
# which is correct for prod but not for dev.
VUE_APP_AUTH0_AUDIENCE=

# Base URL of the serverless API.
VUE_APP_API_BASE_URL=https://api.relay-synth.peebles.lol

# Optional. Default: <site origin>/callback and <site origin> respectively.
# Both must be registered on the Auth0 application - see README > Auth0 setup.
# VUE_APP_AUTH0_REDIRECT_URI=
# VUE_APP_AUTH0_LOGOUT_URI=
